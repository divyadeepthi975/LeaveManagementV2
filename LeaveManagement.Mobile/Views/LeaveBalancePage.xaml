<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LeaveManagement.Mobile.Views.LeaveBalancePage"
             Title="Leave Balance">
    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="10">
            <Label Text="Leave Balance" FontSize="24" FontAttributes="Bold" />
            <Label x:Name="SignedInLabel" AutomationId="LeaveBalanceSignedInLabel" />
            <HorizontalStackLayout Spacing="8">
                <Button Text="Refresh"
                        Clicked="OnRefreshClicked"
                        AutomationId="LeaveBalanceRefreshButton" />
                <Button Text="Sign out"
                        Clicked="OnSignOutClicked"
                        AutomationId="LeaveBalanceSignOutButton" />
            </HorizontalStackLayout>
            <Label x:Name="StatusLabel"
                   AutomationId="LeaveBalanceStatusLabel" />
            <VerticalStackLayout x:Name="BalanceContent"
                                 Spacing="8"
                                 AutomationId="LeaveBalanceContent" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
