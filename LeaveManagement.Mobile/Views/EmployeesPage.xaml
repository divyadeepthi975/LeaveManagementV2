<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LeaveManagement.Mobile.Views.EmployeesPage"
             Title="Employees">
    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="10">
            <Label Text="Employees" FontSize="24" FontAttributes="Bold" />
            <Label x:Name="SignedInLabel" AutomationId="EmployeesSignedInLabel" />
            <HorizontalStackLayout Spacing="8">
                <Button Text="Refresh" Clicked="OnRefreshClicked" AutomationId="EmployeesRefreshButton" />
                <Button Text="Sign out" Clicked="OnSignOutClicked" AutomationId="EmployeesSignOutButton" />
            </HorizontalStackLayout>
            <Label x:Name="StatusLabel" AutomationId="EmployeesStatusLabel" />
            <VerticalStackLayout x:Name="EmployeesContent" Spacing="8" AutomationId="EmployeesContent" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
