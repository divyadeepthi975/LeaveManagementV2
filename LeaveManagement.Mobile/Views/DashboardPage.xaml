<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LeaveManagement.Mobile.Views.DashboardPage"
             Title="Dashboard">
    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="10">
            <Label Text="Dashboard" FontSize="24" FontAttributes="Bold" />
            <Label x:Name="SignedInLabel" AutomationId="DashboardSignedInLabel" />
            <HorizontalStackLayout Spacing="8">
                <Button Text="Refresh"
                        Clicked="OnRefreshClicked"
                        AutomationId="DashboardRefreshButton" />
                <Button Text="Sign out"
                        Clicked="OnSignOutClicked"
                        AutomationId="DashboardSignOutButton" />
            </HorizontalStackLayout>
            <Label x:Name="StatusLabel"
                   AutomationId="DashboardStatusLabel" />
            <VerticalStackLayout x:Name="DashboardContent"
                                 Spacing="8"
                                 AutomationId="DashboardContent" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
