<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LeaveManagement.Mobile.Views.LeavesPage"
             Title="Leaves">
    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="10">
            <Label Text="Leaves" FontSize="24" FontAttributes="Bold" />
            <Label x:Name="SignedInLabel" AutomationId="LeavesSignedInLabel" />
            <HorizontalStackLayout Spacing="8">
                <Button Text="Refresh" Clicked="OnRefreshClicked" AutomationId="LeavesRefreshButton" />
                <Button Text="Sign out" Clicked="OnSignOutClicked" AutomationId="LeavesSignOutButton" />
            </HorizontalStackLayout>
            <Label x:Name="StatusLabel" AutomationId="LeavesStatusLabel" />
            <VerticalStackLayout x:Name="LeavesContent" Spacing="8" AutomationId="LeavesContent" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
