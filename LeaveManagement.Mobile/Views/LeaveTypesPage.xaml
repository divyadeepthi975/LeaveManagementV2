<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LeaveManagement.Mobile.Views.LeaveTypesPage"
             Title="Leave Types">
    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="10">
            <Label Text="Leave Types" FontSize="24" FontAttributes="Bold" />
            <Label x:Name="SignedInLabel" />
            <HorizontalStackLayout Spacing="8">
                <Button Text="Refresh" Clicked="OnRefreshClicked" AutomationId="LeaveTypesRefreshButton" />
                <Button Text="Sign out" Clicked="OnSignOutClicked" AutomationId="LeaveTypesSignOutButton" />
            </HorizontalStackLayout>
            <Label x:Name="StatusLabel" AutomationId="LeaveTypesStatusLabel" />
            <VerticalStackLayout x:Name="LeaveTypesContent" Spacing="8" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
