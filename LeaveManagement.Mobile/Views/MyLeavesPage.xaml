<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LeaveManagement.Mobile.Views.MyLeavesPage"
             Title="My Leaves">
    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="10">
            <Label Text="My Leaves" FontSize="24" FontAttributes="Bold" />
            <Label x:Name="SignedInLabel" />
            <HorizontalStackLayout Spacing="8">
                <Button Text="Refresh" Clicked="OnRefreshClicked" />
                <Button Text="Sign out" Clicked="OnSignOutClicked" />
            </HorizontalStackLayout>
            <Label x:Name="StatusLabel" />
            <VerticalStackLayout x:Name="LeavesContent" Spacing="8" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
